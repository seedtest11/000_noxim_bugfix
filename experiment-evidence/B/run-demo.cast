[11.056961, "o", "direct advertised=1 accepted=1 WEIGHT committed=64\r\nFAIL direct_reserved\r\n"]
[15.067206, "o", "\u001b[2J\u001b[H2/4 B 修复后：原始七个场景\r\n\r\n\r\n$ ./bin/B/acceptance sanity\r\n"]
