[0.016513, "o", "\u001b[2J\u001b[H接收容量一致性 / B / 真实终端验收演示\r\n\r\n相同基线、相同测试场景；运行已构建的程序。\r\n构建过程不包含在本段演示中。\r\n"]
[3.020951, "o", "\u001b[2J\u001b[H1/4 修复前：五个缺陷应被复现\r\n\r\n\r\n$ ./bin/baseline/acceptance shared_committed\r\n"]
